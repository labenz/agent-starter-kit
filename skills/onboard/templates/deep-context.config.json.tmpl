{
  "_comment": "Deep Context settings generated by `kit apply` from profile.yaml. The launchd and grind wrappers export DEEP_CONTEXT_DB / DEEP_CONTEXT_VECTOR_DB / DEEP_CONTEXT_EMBED_PROVIDER from this file, so all data lives under ~/.agent-kit and `kit update` never touches it. Rendered from Phase 2 (seed) onward.",
  "schema_version": 2,

  "owner": {
    "emails": [{{#each sources.approved}}{{#if account}}"{{account}}"{{#unless @last}}, {{/unless}}{{/if}}{{/each}}],
    "agent_emails": [],
    "_note": "OWNER_CONFIG for the toolkit: which addresses are the person (so direction and authorship are right). agent_emails stays empty until an employee agent has its own address."
  },

  "import": {
    "takeout_zip": "{{seed.takeout_zip}}",
    "seed_since_days": {{seed.window_days}},
    "_note": "`bun ~/deep-context-toolkit/tools/import-takeout.ts <zip> --since 30d` for the seed; the same zip with no --since for the grind. Takeout = Mail (mbox) + Calendar (.ics), no OAuth app. OAuth users use gmail-extractor.ts instead."
  },

  "paths": {
    "db": "{{environment.kit_home}}/data/deep-context/deep_context.db",
    "vector_db": "{{environment.kit_home}}/data/deep-context/deep_context_vec.db",
    "contacts_db": "{{environment.kit_home}}/data/deep-context/contacts.db"
  },

  "sources": {
    "gmail":     {{#if (includes modules.deep_context_sources "gmail")}}true{{else}}false{{/if}},
    "calendar":  {{#if (includes modules.deep_context_sources "calendar")}}true{{else}}false{{/if}},
    "slack":     {{#if (includes modules.deep_context_sources "slack")}}true{{else}}false{{/if}},
    "slack-dm":  {{#if (includes modules.deep_context_sources "slack-dm")}}true{{else}}false{{/if}},
    "beeper":    {{#if (includes modules.deep_context_sources "beeper")}}true{{else}}false{{/if}},
    "fireflies": {{#if (includes modules.deep_context_sources "fireflies")}}true{{else}}false{{/if}},
    "twitter":   {{#if (includes modules.deep_context_sources "twitter")}}true{{else}}false{{/if}}
  },

  "processing": {
    "enrichment": {{#if consent.gemini_enrichment}}"gemini"{{else}}"off"{{/if}},
    "embeddings": "{{consent.embeddings}}",
    "rerank": {{#if consent.voyage_rerank}}"voyage"{{else}}"off"{{/if}},
    "_note": "embeddings: none = keyword search only; ollama = local (DEEP_CONTEXT_EMBED_PROVIDER=ollama, `ollama pull nomic-embed-text`); gemini = sends text to Google."
  },

  "privacy": {
    "exclude_people": {{json risk.exclude_people}},
    "exclude_chats": {{json risk.exclude_chats}},
    "family_rule": "{{risk.family_rule}}",
    "family_people": [{{#each person.people.home}}"{{name}}"{{#unless @last}}, {{/unless}}{{/each}}],
    "never_send_to_third_parties": {
      "_note": "Messages matching these are stored locally but skipped by enrichment, embeddings, and rerank.",
      "keywords": [{{#each confidential.matters}}{{#each keywords}}"{{this}}", {{/each}}"{{name}}"{{#unless @last}}, {{/unless}}{{/each}}],
      "domains": [{{#each confidential.matters}}{{#each privileged_domains}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}{{#unless @last}}, {{/unless}}{{/each}}]
    }
  },

  "wiki": {
    "root": "{{environment.kit_home}}/wiki",
    "summaries": "{{environment.kit_home}}/data/deep-context/summaries",
    "order": "newest-first",
    "trees": ["private"],
    "_note": "Monthly summaries -> annual roll-ups -> articles under people/ organizations/ projects/ positions/ expertise/ timeline/. A derived shared tree (sensitive content stripped) is created only if an employee agent is ever added."
  },

  "_gaps": "⚠️ Settings that need code in the public toolkit before they take effect: privacy.never_send_to_third_parties (skip-list for enrichment/embeddings), family_rule 'logistics-only' (calendar yes, messages no), and import.takeout_zip (tools/import-takeout.ts is being built; check `deps.json` pins a tag that has it). Until then, `kit apply` refuses to turn on Gemini enrichment or Gemini embeddings when confidential matters exist, family_rule logistics-only is implemented as exclude_people for message sources, and the seed falls back to connectors or OAuth."
}
